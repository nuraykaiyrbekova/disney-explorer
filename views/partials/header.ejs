<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Disney Explorer</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <a class="logo" href="/">✨ Disney Explorer</a>
    <nav>
      <a href="/">Home</a>
      <a href="/characters">Characters</a>
      <a href="/top">Top</a>
      <a href="/compare">Compare</a>
    </nav>
    <%# Поиск в шапке: виден на каждой странице, отправляет GET /search?q=... %>
    <form action="/search" method="GET" class="header-search">
      <label for="header-q" class="visually-hidden">Search characters</label>
      <input type="text" id="header-q" name="q" placeholder="Search character...">
      <button type="submit">Search</button>
    </form>
  </header>
  <main class="container"> 
