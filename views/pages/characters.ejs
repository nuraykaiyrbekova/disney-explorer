<%- include('../partials/header') %>

<h1>Characters</h1>

<%# Панель фильтров: форма лежит в отдельном блоке %>
<form action="/characters" method="GET" class="toolbar filter-panel">
  <label for="sort">Sort by</label>
  <select id="sort" name="sort">
    <option value="name" <%= sort === 'name' ? 'selected' : '' %>>Name (A–Z)</option>
    <option value="appearances" <%= sort === 'appearances' ? 'selected' : '' %>>Most appearances</option>
  </select>
  <button type="submit">Apply</button>
</form>

<%# Ряд карточек со статистикой, считается в catalogController %>
<% if (stats) { %>
<section class="summary">
  <div class="summary-item"><strong><%= stats.shown %></strong><span>characters on this page</span></div>
  <div class="summary-item"><strong><%= totalPages %></strong><span>pages in catalog</span></div>
  <div class="summary-item"><strong><%= stats.topCount %></strong><span>most appearances: <%= stats.topName %></span></div>
  <div class="summary-item"><strong><%= stats.average %></strong><span>average appearances</span></div>
</section>
<% } %>

<p class="count">Page <%= page %> of <%= totalPages %> · <%= characters.length %> characters shown</p>

<div class="grid">
  <% characters.forEach(function (c) { %>
    <%- include('../partials/card', { c: c }) %>
  <% }); %>
</div>

<nav class="pagination">
  <% if (page > 1) { %>
    <a href="/characters?page=<%= page - 1 %>&sort=<%= sort %>">← Previous</a>
  <% } %>
  <span>Page <%= page %> of <%= totalPages %></span>
  <% if (page < totalPages) { %>
    <a href="/characters?page=<%= page + 1 %>&sort=<%= sort %>">Next →</a>
  <% } %>
</nav>

<%- include('../partials/footer') %> 
